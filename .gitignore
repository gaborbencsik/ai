# qmd's persistent SQLite index + ~319 MB embedding model.
# Symlinked from ~/.cache/qmd inside the sandbox so it survives `sbx rm`.
/.qmd-cache/

# Built kit dir: sbx-spec.yaml with the real ANTHROPIC_API_KEY injected by
# `make kit-build`. Contains a secret — never commit.
/.kit/
autonomous-dev-*

# Runtime dependencies — reinstall with `npm install` / `npm ci`.
node_modules/

# Bundled build output: regenerate with `npm run build` (vscode-extension).
# Tracked copies existed by mistake; `git rm -r --cached` cleans them up.
extensions/vscode-extension/dist/

# Packaged release artifacts (vsix) — reproducible via `npm run package`.
extensions/vscode-extension/*.vsix

# Machine-local OMP extension links (absolute-path symlinks, per-machine).
.omp/
