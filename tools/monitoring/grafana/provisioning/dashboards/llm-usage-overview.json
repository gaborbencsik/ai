{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      },
      {
        "name": "project",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(claude_code_cost_usage_USD_total, project)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "label": "Project"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total cost (USD)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } } },
      "targets": [
        { "refId": "A", "expr": "sum(max_over_time(claude_code_cost_usage_USD_total{project=~\"$project\"}[$__range]))" }
      ]
    },
    {
      "type": "stat",
      "title": "Total tokens",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "blue", "value": null } ] } } },
      "targets": [
        { "refId": "A", "expr": "sum(max_over_time(claude_code_token_usage_tokens_total{project=~\"$project\"}[$__range]))" }
      ]
    },
    {
      "type": "stat",
      "title": "Sessions",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "purple", "value": null } ] } } },
      "targets": [
        { "refId": "A", "expr": "sum(max_over_time(claude_code_session_count_total{project=~\"$project\"}[$__range]))" }
      ]
    },
    {
      "type": "stat",
      "title": "Lines of code changed",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "orange", "value": null } ] } } },
      "targets": [
        { "refId": "A", "expr": "sum(max_over_time(claude_code_lines_of_code_count_total{project=~\"$project\"}[$__range]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cost by project (USD)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } } } },
      "targets": [
        { "refId": "A", "expr": "sum by (project) (max_over_time(claude_code_cost_usage_USD_total{project=~\"$project\"}[$__range]))", "legendFormat": "{{project}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens by model",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } } } },
      "targets": [
        { "refId": "A", "expr": "sum by (model) (max_over_time(claude_code_token_usage_tokens_total{project=~\"$project\"}[$__range]))", "legendFormat": "{{model}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Input tokens by project",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (project) (max_over_time(claude_code_token_usage_tokens_total{project=~\"$project\", type=\"input\"}[$__range]))", "legendFormat": "{{project}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Output tokens by project",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (project) (max_over_time(claude_code_token_usage_tokens_total{project=~\"$project\", type=\"output\"}[$__range]))", "legendFormat": "{{project}}" }
      ]
    },
    {
      "type": "piechart",
      "title": "Tokens by type",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "sum by (type) (max_over_time(claude_code_token_usage_tokens_total{project=~\"$project\"}[$__range]))", "legendFormat": "{{type}}", "instant": true }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token consumption rate (tokens/min)",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "sum by (model) (rate(claude_code_token_usage_tokens_total{project=~\"$project\"}[5m])) * 60", "legendFormat": "{{model}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool-use decisions (accept / reject)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } } } },
      "targets": [
        { "refId": "A", "expr": "sum by (decision) (max_over_time(claude_code_code_edit_tool_decision_count_total{project=~\"$project\"}[$__range]))", "legendFormat": "{{decision}}" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["claude-code", "llm-usage"],
  "time": { "from": "now-7d", "to": "now" },
  "timezone": "browser",
  "title": "LLM Usage — Overview",
  "uid": "llm-usage-overview",
  "version": 4
}
